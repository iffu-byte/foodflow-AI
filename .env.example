# Copy to .env for local runs. Generate a unique value, for example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
ENV=dev
AUTH_SECRET=
DATABASE_URL=postgresql+asyncpg://foodflow:foodflow@localhost:5432/foodflow
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
ROUTING_PROVIDER=haversine
OSRM_BASE_URL=http://localhost:5000
ROUTING_TIMEOUT_S=2.0
ROUTING_CACHE_TTL_S=300
OFFER_SWEEP_INTERVAL_S=5
ETA_MODEL_PATH=artifacts/eta_model.joblib
VITE_API_URL=http://localhost:8000
# Optional MapLibre style URL. Leave blank to use the public OpenStreetMap demo style.
VITE_MAP_STYLE_URL=
# Optional AI and maps keys. Everything works without them using local fallbacks;
# with them, portion photos get a vision cross-check and kitchens get Google photos.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GOOGLE_MAPS_API_KEY=
AI_DAILY_BUDGET_USD=0.50
GEOFENCE_RADIUS_M=150
